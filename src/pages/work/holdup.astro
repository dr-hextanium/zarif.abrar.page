---
import Page from "../../components/Page.astro";
import { holdupCheckoutURL } from "../../data/work";

const tagline = "a menu bar app that ejects external disks and names what is holding them.";
---

<Page title="holdup" description={tagline}>
  <h2>holdup</h2>
  <p class="lede">{tagline}</p>

  {/* screenshot goes here once one exists: an <img> of the menu bar panel with a refused eject and its holders, with alt text */}

  <p class="buy">
    {holdupCheckoutURL
      ? <a href={holdupCheckoutURL}>buy, $4.99</a>
      : <span>coming soon, $4.99</span>}
  </p>

  <div class="product">
    <section>
      <h3>what it does</h3>
      <ul>
        <li>lists your external disks.</li>
        <li>eject one disk, or eject all.</li>
        <li>when an eject is refused, shows which apps or processes hold the disk (open files, working folders) and lets you quit them.</li>
        <li>retries the eject automatically once they let go.</li>
      </ul>
    </section>

    <section>
      <h3>free and paid</h3>
      <p>free forever: list, eject, see holders, quit holders, auto-retry.</p>
      <p>paid: force quit, force eject, and admin scan, which finds holders that need admin rights.</p>
      <p>you get 3 free paid fixes to try. a fix is a force action or admin scan that succeeds.</p>
    </section>

    <section>
      <h3>price</h3>
      <p>$4.99 once. a license key covers up to 3 Macs. no subscription.</p>
      <p>sold through Lemon Squeezy, which handles payment and sales tax.</p>
    </section>

    <section>
      <h3>requirements</h3>
      <p>macOS 26 or later.</p>
    </section>

    <section>
      <h3>privacy</h3>
      <p>the app never fetches anything except the license check with Lemon Squeezy. no analytics in the app.</p>
    </section>

    <section id="refunds">
      <h3>refunds</h3>
      <p>email within 14 days of purchase for a full refund.</p>
    </section>

    <section id="contact">
      <h3>contact</h3>
      <p><a data-mail="Holdup" data-show>zarif [at] abrar [dot] page</a></p>
    </section>

    <section id="releases">
      <h3>releases</h3>
      <p>1.0, coming soon.</p>
    </section>
  </div>
</Page>
