---
import Page from "../components/Page.astro";
import { work } from "../data/work";
import { apps } from "../data/apps";
import { accounts } from "../data/accounts";

const pb = "15.73";
// last known lichess ratings: shown until the cached or live ones replace them, so the strip never jumps
const lichess = `https://lichess.org/@/${accounts.lichess}`;
const ratings = [["rapid", 1689, `${lichess}/perf/rapid`], ["puzzle", 2000, lichess]] as const;
// one is picked per visit
const lines = [
  "if something here made you think of something, tell me.",
  "write to me. i read the long ones too.",
  "say hi.",
  "your move.",
  "i'm probably losing a rapid game right now.",
];
---

<Page description="zarif abrar studies biochemistry at stony brook and builds software and small machines.">
  <div class="hero">
    <div class="card">
      <h1>zarif abrar</h1>
      <p>i study biochemistry at stony brook and build software and small machines.</p>
      <p class="looking-line" data-looking-only hidden>currently looking for <span data-looking-phrase></span>.</p>
    </div>
    <div class="record" data-live="record" data-state="stopped" aria-hidden="true">
      <div class="art fallback"></div>
      <img class="art" data-live="album-art" alt="" hidden />
    </div>
    <div class="np" data-live="np" hidden></div>
  </div>

  <ul class="strip" aria-label="status">
    <li class="open" data-looking-only hidden>open to <span data-looking-phrase></span></li>
    <li data-live="lichess">
      <svg viewBox="0 0 16 16"><path d="M5 14h7M6 12h5l-1-5 2-2-3-3-2 2-2 1 1 2-1 1z"/></svg>
      <span data-live-text>lichess {ratings.map(([perf, rating, href], i) => <Fragment>{i ? ", " : ""}<a href={href}>{perf} {rating}</a></Fragment>)}</span>
      <script is:inline>
        // last fetched ratings from this browser, filled before first paint
        try {
          const cached = localStorage.getItem("lichess");
          if (cached) document.currentScript.previousElementSibling.innerHTML = cached;
        } catch {}
      </script>
    </li>
    <li>
      <svg viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" rx="1.5"/><path d="M6 2v12M10 2v12M2 6h12M2 10h12"/></svg>
      cube pb {pb}
    </li>
    <li data-live="github" hidden>
      <svg viewBox="0 0 16 16"><circle cx="4" cy="4" r="1.6"/><circle cx="4" cy="12" r="1.6"/><circle cx="12" cy="8" r="1.6"/><path d="M4 5.6v4.8M5.4 4.6c3 .2 5 1.4 5.2 2"/></svg>
      <span data-live-text></span>
    </li>
  </ul>

  <div class="prose">
    <div class="working">
      <h3>what i'm working on</h3>
      <ul>
        {work.filter((w) => w.wip).map((w) => <li><a href={w.href}>{w.title}</a> <span>: {w.summary}</span></li>)}
        {apps.filter((a) => a.page).map((a) => <li><a href={`/apps/${a.slug}`}>apps/{a.slug}</a> <span>: {a.blurb}.</span></li>)}
      </ul>
    </div>

    <p class="closing">
      <span data-closing data-lines={JSON.stringify(lines)}>{lines[0]}</span>
      <a class="mail" data-mail data-show>zarif [at] abrar [dot] page</a>
    </p>
  </div>
</Page>
