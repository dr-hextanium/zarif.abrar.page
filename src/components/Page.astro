---
import "@fontsource/petrona/300.css";
import "@fontsource/petrona/400.css";
import "@fontsource/petrona/500.css";
import "@fontsource/petrona/700.css";
import "@fontsource/petrona/400-italic.css";
import "@fontsource/petrona/500-italic.css";
import "../styles/global.css";
import { accounts } from "../data/accounts";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title}, zarif abrar` : "zarif abrar";
const path = Astro.url.pathname.replace(/\/$/, "");
const links = ["work", "apps", "margins", "figments"];
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			document.documentElement.classList.add("js");
			// entrance fades play on the first visit only; after that pages appear as they are
			try {
				if (localStorage.getItem("seen")) document.documentElement.classList.add("seen");
				else localStorage.setItem("seen", "1");
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:title" content={fullTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content="website" />
	</head>
	<body>
		<div class="wrap">
			<nav class="site" aria-label="site">
				<a href="/" class="home">zarif abrar</a>
				{links.map((l) => <a href={`/${l}`} aria-current={path === `/${l}` ? "page" : undefined}>{l}</a>)}
			</nav>
			<main><slot /></main>
			<footer>
				<a data-mail data-show data-copy>zarif [at] abrar [dot] page</a>
				<a href={`https://github.com/${accounts.github}`}>github</a>
				<a href="https://www.linkedin.com/in/zarifabrar/">linkedin</a>
				<a href="https://www.instagram.com/zarif.k.abrar/">instagram</a>
				<span class="status" data-live="discord" hidden><span class="dot"></span><span data-live-text></span></span>
				<span class="status" data-live="offline" hidden><span class="dot"></span><span>offline</span></span>
			</footer>
		</div>
		<script is:inline>
			// inline so it runs before first paint: the placeholder address never flashes.
			// the address is never in the html, so scrapers reading raw pages miss it.
			// it is put together here and filled into every a[data-mail], with an optional subject.
			const address = ["zarif", "abrar.page"].join("@");
			document.querySelectorAll("a[data-mail]").forEach((a) => {
				const subject = a.dataset.mail;
				a.href = `mailto:${address}${subject ? `?subject=${encodeURIComponent(subject)}` : ""}`;
				if (a.hasAttribute("data-show")) a.textContent = address;
			});

			// click copies the address; if the clipboard is unavailable, the mailto link works as usual
			document.querySelectorAll("a[data-copy]").forEach((a) => {
				a.title = "click to copy";
				a.addEventListener("click", (e) => {
					if (!navigator.clipboard) return;
					e.preventDefault();
					navigator.clipboard.writeText(address).then(
						() => {
							a.style.minWidth = `${a.offsetWidth}px`; // keep the footer from shifting
							a.textContent = "copied";
							setTimeout(() => (a.textContent = address), 1500);
						},
						() => (location.href = a.href),
					);
				});
			});
		</script>
		<script>import "../scripts/live/mount.ts";</script>
		{import.meta.env.PROD && <script is:inline>navigator.serviceWorker?.register("/sw.js").catch(() => {});</script>}
	</body>
</html>
