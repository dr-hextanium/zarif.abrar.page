---
import "@fontsource/petrona/300.css";
import "@fontsource/petrona/400.css";
import "@fontsource/petrona/500.css";
import "@fontsource/petrona/700.css";
import "@fontsource/petrona/400-italic.css";
import "@fontsource/petrona/500-italic.css";
import "../styles/global.css";
import { accounts } from "../data/accounts";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const links = ["work", "margins", "figments", "photos"];
const discord = `https://discord.com/users/${accounts.discordId}`;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ? `${title}, zarif abrar` : "zarif abrar"}</title>
	</head>
	<body>
		<div class="wrap">
			<nav class="site" aria-label="site">
				<a href="/" class="home">zarif abrar</a>
				{links.map((l) => <a href={`/${l}`} aria-current={path === `/${l}` ? "page" : undefined}>{l}</a>)}
			</nav>
			<main><slot /></main>
			<footer>
				<a data-mail data-show>zarif [at] abrar [dot] page</a>
				<span data-live="discord" hidden><span class="dot"></span><a href={discord} data-live-text></a></span>
				<span data-live="offline" hidden><span class="dot"></span><a href={discord}>offline</a></span>
			</footer>
		</div>
		<script>
			// the address is never in the html, so scrapers reading raw pages miss it.
			// it is put together here and filled into every a[data-mail], with an optional subject.
			const address = ["zarif", "abrar.page"].join("@");
			document.querySelectorAll<HTMLAnchorElement>("a[data-mail]").forEach((a) => {
				const subject = a.dataset.mail;
				a.href = `mailto:${address}${subject ? `?subject=${encodeURIComponent(subject)}` : ""}`;
				if (a.hasAttribute("data-show")) a.textContent = address;
			});
		</script>
		<script>import "../scripts/live/mount.ts";</script>
	</body>
</html>
